---
// Mentaat logo. Single-path "M" mark using fill="currentColor", so it tints to
// whatever `color` the wrapper sets. We point that at the brand-accent token,
// so the logo always tracks the active theme (currently the punchy blue).
interface Props {
  height?: number;
  wordmark?: boolean;
}
const { height = 28, wordmark = true } = Astro.props;
const w = Math.round(height * (266 / 279));
---

<span class="mentaat-logo" style="display:inline-flex;align-items:center;gap:0.5rem;color:var(--semanticColorBackgroundAccent);line-height:1;">
  <svg width={w} height={height} viewBox="0 0 266 279" role="img" aria-label="Mentaat">
    <g transform="translate(0,279) scale(0.1,-0.1)" fill="currentColor" stroke="currentColor" stroke-width="220" stroke-linejoin="round" stroke-linecap="round">
      <path d="M1350 2055 c-36 2 -82 0 -103 -5 -20 -5 -61 -22 -90 -36 -37 -19 -111 -85 -262 -235 -116 -115 -215 -209 -220 -209 -6 0 -99 89 -208 198 l-198 197 -90 -94 -91 -94 513 -512 c483 -482 518 -514 574 -536 46 -18 80 -23 150 -24 81 0 97 3 159 33 61 29 96 59 281 242 116 116 215 210 220 210 6 0 95 -85 198 -190 103 -104 192 -192 197 -195 5 -3 51 35 102 85 l92 91 -485 485 c-273 273 -509 502 -542 524 -32 22 -75 44 -95 50 -20 6 -66 13 -102 15z m14 -267 c16 -4 38 -15 48 -25 11 -10 96 -92 190 -182 93 -90 174 -173 180 -184 9 -17 -13 -43 -183 -213 -107 -107 -209 -201 -227 -210 -23 -11 -46 -14 -70 -9 -31 5 -70 39 -234 203 -109 108 -198 201 -198 207 0 6 91 102 203 212 158 157 209 202 232 205 17 2 43 0 59 -4z"></path>
    </g>
  </svg>
  {wordmark && <span style="font-weight:700;font-size:1.15rem;letter-spacing:-0.02em;color:#0a0a0a;">Mentaat</span>}
</span>
