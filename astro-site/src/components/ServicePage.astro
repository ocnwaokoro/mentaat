---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import '../styles/homepage.css';
import '../styles/service.css';

// Dark-editorial service page. Full-bleed band rhythm (dark hero -> light problem ->
// dark numbered process -> light proof tiles -> dark CTA), oversized type, monospace
// accents, deliberate labeled image placeholders. Each service passes its copy via props.
const {
  title, description, eyebrow, headingHtml, sub, heroPhLabel,
  leadHtml, how = [], proof = [], ctaHeadHtml, ctaSub,
} = Astro.props;
---

<Base title={title} description={description}>
  <div id="__next">
    <div class="app_site--homepage__E5h5V app_loggedOut__HHvfJ">
      <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--space-between__LdB4V Layout_layout__u6BrU">
        <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Layout_content__q1d4E">
          <Header />
          <main class="svc">

            {/* HERO */}
            <section class="svc-band svc-band--dark svc-hero">
              <div class="svc-inner">
                <div>
                  <span class="svc-eyebrow">{eyebrow}</span>
                  <h1 class="svc-h1" set:html={headingHtml} />
                  <p class="svc-sub">{sub}</p>
                  <div class="svc-cta-row">
                    <a href="/contact" class="svc-btn svc-btn--primary">Book a call</a>
                    <a href="/work" class="svc-btn svc-btn--ghost">See our work</a>
                  </div>
                </div>
                <div class="svc-ph svc-ph--hero" data-label={heroPhLabel}></div>
              </div>
            </section>

            {/* PROBLEM */}
            <section class="svc-band svc-band--light">
              <div class="svc-inner">
                <p class="svc-lead" set:html={leadHtml} />
              </div>
            </section>

            {/* HOW WE WORK */}
            <section class="svc-band svc-band--dark">
              <div class="svc-inner">
                <span class="svc-eyebrow">// how we work</span>
                <h2 class="svc-section-head">We go in, then we build</h2>
                <div class="svc-steps">
                  {how.map((s) => (
                    <div class="svc-step">
                      <div class="svc-step-num">{s.num}</div>
                      <div>
                        <p class="svc-step-label">{s.label}</p>
                        <h3 class="svc-step-title">{s.title}</h3>
                        <p class="svc-step-body">{s.body}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </section>

            {/* PROOF */}
            <section class="svc-band svc-band--light">
              <div class="svc-inner">
                <span class="svc-eyebrow">// proof, not promises</span>
                <h2 class="svc-section-head">Work we have actually done</h2>
                <div class="svc-proof-grid">
                  {proof.map((p) => (
                    <a href={p.href} class="svc-case">
                      <div class="svc-ph svc-ph--wide" data-label={p.phLabel}></div>
                      <div class="svc-case-body">
                        <p class="svc-case-metric" set:html={p.metricHtml} />
                        <p class="svc-case-title">{p.title}</p>
                        <p class="svc-case-client">{p.client}</p>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </section>

            {/* CTA */}
            <section class="svc-band svc-band--dark svc-cta">
              <div class="svc-inner">
                <h2 class="svc-cta-head" set:html={ctaHeadHtml} />
                <p class="svc-cta-sub">{ctaSub}</p>
                <div class="svc-cta-row">
                  <a href="/contact" class="svc-btn svc-btn--primary">Book a call</a>
                </div>
              </div>
            </section>

          </main>
          <Footer />
        </div>
      </div>
    </div>
  </div>
</Base>
