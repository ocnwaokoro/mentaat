---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import '../styles/homepage.css';
import '../styles/congruent.css';

// Congruent service page — built from the REAL design system (Aeonik via Heading/Text,
// real Badge + BaseButton, tile 8px cards, measured #0a131a dark surface). Rhymes with
// the homepage tiles by construction; its own voice via numbered process + section heads.
const {
  meta, how = [], proof = [],
  howHeading = 'How we go in, and build',
  proofHeading = 'What we have built',
} = Astro.props;

const head02white = 'Heading_heading__me6NI Heading_heading--02__GxsbA Heading_align--left__hNEzl Heading_color--white__5VAp3';
const head02dark = 'Heading_heading__me6NI Heading_heading--02__GxsbA Heading_align--left__hNEzl Heading_color--primary___QOq1';
const head02base = 'Heading_heading__me6NI Heading_heading--02__GxsbA Heading_align--left__hNEzl';
const head05white = 'Heading_heading__me6NI Heading_heading--05__4gkI8 Heading_align--left__hNEzl Heading_color--white__5VAp3';
const head05dark = 'Heading_heading__me6NI Heading_heading--05__4gkI8 Heading_align--left__hNEzl Heading_color--primary___QOq1';
const textSec = 'Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--01__aiSyT Text_deprecatedMargin--none__sZLCS';
const textSec2 = 'Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--02__HVmZN Text_deprecatedMargin--none__sZLCS';
const badge = 'Badge_badge__A7OHD Badge_color--accent__Vuh4G Badge_size--medium__MxotV';
const colL = 'Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Flex_gap--l__lrJk4';
const colS = 'Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Flex_gap--s__0656J';
const btnRow = 'Flex_flex___mzvZ Flex_align--center__9VuNC Flex_direction--row__W6CGY Flex_justify--start__vk9Tl ButtonRow_buttonRow__hs7qV Flex_gap--s__0656J';
const btnPrimary = 'BaseButton_button__S8cdB BaseButton_size--large__dpOfr BaseButton_importance--primary__1_2vI MarketingLinkButton_marketingLinkButton__n8FI4 BaseButton_color--accent-main__KBIuP FocusRing_focusRing__izyZU';
const btnSecondary = 'BaseButton_button__S8cdB BaseButton_size--large__dpOfr BaseButton_importance--secondary__qMmu3 MarketingLinkButton_marketingLinkButton__n8FI4 BaseButton_color--accent-main__KBIuP FocusRing_focusRing__izyZU';
---

<Base title={meta.title} description={meta.description}>
  <div id="__next">
    <div class="app_site--homepage__E5h5V app_loggedOut__HHvfJ">
      <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--space-between__LdB4V Layout_layout__u6BrU">
        <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Layout_content__q1d4E">
          <Header />
          <main class="Layout_main__nbmiJ index_layout__cD6cr cong">
            <div class="index_container__9GuY8">
              <div class="cong-stack">

                {/* HERO — dark tile surface */}
                <div class="cong-card cong-card--dark theme--dark">
                  <div class="cong-hero">
                    <div class={colL}>
                      <span class={badge}>{meta.badge}</span>
                      <h1 class={head02white} set:html={meta.headingHtml} />
                      <p class={textSec}>{meta.sub}</p>
                      <div class={btnRow}>
                        <a href="/contact" class={btnPrimary}><span>Book a call</span></a>
                        <a href="/work" class={btnSecondary}><span>See our work</span></a>
                      </div>
                    </div>
                    <div class="cong-ph"></div>
                  </div>
                </div>

                {/* PROBLEM — blue tint card */}
                <div class="cong-card cong-card--tint">
                  <div class={colS}>
                    <h2 class={head02dark} set:html={meta.problemHtml} />
                    <p class={textSec}>{meta.problemBody}</p>
                  </div>
                </div>

                {/* HOW WE WORK — numbered dark tiles */}
                <div class="cong-sec">
                  <h2 class={head02dark}>{howHeading}</h2>
                  <div class="cong-row3">
                    {how.map((s) => (
                      <div class="cong-card cong-card--dark theme--dark">
                        <div class={colS}>
                          <span class={`${head02base} cong-num`}>{s.num}</span>
                          <h3 class={head05white}>{s.title}</h3>
                          <p class={textSec2}>{s.body}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>

                {/* PROOF — white tiles with image */}
                <div class="cong-sec">
                  <h2 class={head02dark}>{proofHeading}</h2>
                  <div class="cong-row2">
                    {proof.map((p) => (
                      <a href={p.href} class="cong-card cong-card--white cong-case">
                        <div class="cong-metric"><span set:html={p.metricHtml} /></div>
                        <div class="cong-case-body">
                          <div class={colS}>
                            <p class={textSec2}>{p.title}</p>
                            <p class="Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--04__2p_2C cong-attribution">{p.client}</p>
                          </div>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>

                {/* CTA — dark tile */}
                <div class="cong-card cong-card--dark theme--dark cong-center">
                  <div class={`${colL} cong-cta-center`}>
                    <h2 class={head02white} set:html={meta.ctaHeadHtml} />
                    <p class={textSec}>{meta.ctaSub}</p>
                    <div class={btnRow}>
                      <a href="/contact" class={btnPrimary}><span>Book a call</span></a>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </main>
          <Footer />
        </div>
      </div>
    </div>
  </div>
</Base>
