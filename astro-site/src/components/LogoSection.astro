---
import { marqueeLogos as LOGOS } from '../config/images.js';
const slideClass = 'Flex_flex___mzvZ Flex_align--center__9VuNC Flex_direction--row__W6CGY Flex_justify--start__vk9Tl LogoSection_slide__VPla0';
// Duplicated once for the seamless marquee loop
const track = [...LOGOS, ...LOGOS];
---

<section class="LogoSection_logoSection__t58uZ">
  <div class="LogoSection_slider__oD3c2" style="--n-logos: 15">
    <div class="Flex_flex___mzvZ Flex_align--center__9VuNC Flex_direction--row__W6CGY Flex_justify--start__vk9Tl LogoSection_sliderTrack__Wk41d">
      {track.map((logo) => (
        <div class={slideClass}>
          <img alt={logo.alt} loading="lazy" width="134" height="48" decoding="async" class="LogoSection_logo__Gkdzt" src={logo.src} />
        </div>
      ))}
    </div>
  </div>
</section>
