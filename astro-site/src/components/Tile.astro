---
interface Props {
  badge: string;
  titleHtml: string;
  description: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
  imageSrc: string;
  imageAlt: string;
  theme?: 'dark' | 'light' | 'white';
}
const {
  badge, titleHtml, description, primaryHref, primaryLabel,
  secondaryHref, secondaryLabel, imageSrc, imageAlt, theme = 'dark',
} = Astro.props;

const themeClass =
  theme === 'dark' ? 'Tile_theme--dark__tjjdY theme--dark'
  : theme === 'light' ? 'Tile_theme--light__frISr theme--light'
  : 'Tile_theme--white__Wi4h2 theme--light';
const titleColorClass = theme === 'dark' ? 'Heading_color--white__5VAp3' : 'Heading_color--primary___QOq1';
const badgeColorClass = theme === 'white' ? 'Badge_color--gray__pkQCI' : 'Badge_color--accent__Vuh4G';
const tileMod = theme === 'dark' ? '' : theme === 'light' ? ' Tile_tile--1__WpfCL' : ' Tile_tile--2__1Ux2k';
const imageMod = theme === 'dark' ? '' : theme === 'light' ? ' Tile_image--1__ZHiA9' : ' Tile_image--2__45Iac';
---

<div class={`MockButton_mockButton__qajJp Tile_tile__PBrif${tileMod} MockButton_clickable__60jT_ FocusRing_focusRing__izyZU`} role="button" tabindex="0">
  <div class={`Tile_theme__R02Fl ${themeClass}`}>
    <div class="Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--row__W6CGY Flex_justify--start__vk9Tl Tile_container__zDoA5">
      <div class="Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Tile_content___Y878 Flex_gap--xxl__mFPOt">
        <span class={`Badge_badge__A7OHD ${badgeColorClass} Badge_size--medium__MxotV`}>{badge}</span>
        <div class="Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Flex_gap--l__lrJk4">
          <h2 class={`Heading_heading__me6NI Heading_heading--02__GxsbA Tile_title__g73a0 Heading_align--left__hNEzl ${titleColorClass}`} set:html={titleHtml}></h2>
          <p class="Tile_description__NV9Re Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--01__aiSyT Text_deprecatedMargin--none__sZLCS">{description}</p>
          <div>
            <div class="Flex_flex___mzvZ Flex_align--center__9VuNC Flex_direction--row__W6CGY Flex_justify--start__vk9Tl ButtonRow_buttonRow__hs7qV Flex_gap--s__0656J">
              <a target="_self" rel="noreferrer" href={primaryHref} class="BaseButton_button__S8cdB BaseButton_size--large__dpOfr BaseButton_importance--primary__1_2vI MarketingLinkButton_marketingLinkButton__n8FI4 BaseButton_color--accent-main__KBIuP FocusRing_focusRing__izyZU">
                <span>{primaryLabel}</span>
              </a>
              <a target="_self" rel="noreferrer" href={secondaryHref} class="BaseButton_button__S8cdB BaseButton_size--large__dpOfr BaseButton_importance--secondary__qMmu3 MarketingLinkButton_marketingLinkButton__n8FI4 BaseButton_color--accent-main__KBIuP FocusRing_focusRing__izyZU">
                <span>{secondaryLabel}</span>
              </a>
            </div>
          </div>
        </div>
      </div>
      <img alt={imageAlt} loading="lazy" width="1000" height="1214" decoding="async" class={`Tile_image__W5sVF${imageMod}`} src={imageSrc} />
    </div>
  </div>
</div>
