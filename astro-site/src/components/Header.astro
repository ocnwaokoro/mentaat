---
// Site header — clean responsive nav, navigable at every width. The Feedly header's
// mobile variant was never implemented (empty + sf-hidden), so this replaces it.
import Logo from './Logo.astro';
import { site } from '../config/site.js';
import '../styles/header.css';
const { overlay = false } = Astro.props;
---

<header class={`mh${overlay ? ' mh--overlay' : ''}`}>
  <div class="mh-inner">
    <a class="mh-logo" href="/" aria-label="Mentaat home"><Logo height={28} /></a>
    <nav class="mh-nav" aria-label="Primary">
      <a href="/work">Work</a>
      <a href="/services">Services</a>
      <a href="/about">About</a>
    </nav>
    <a class="mh-cta" href={site.bookingUrl} target="_blank" rel="noopener">Book a call</a>
  </div>
</header>
