---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { pageHtml } from '../html/threat-intel.js';
import { applyImageOverrides } from '../config/images.js';
import '../styles/threat-intel.css';

// Reskinned Feedly service-page design. Strip the embedded Feedly chrome; our chrome wraps it.
// Content is still Feedly (re-content + route rename to /services/web-development is next).
const body = applyImageOverrides(
  pageHtml.replace(/<header[\s\S]*?<\/header>/g, '').replace(/<footer[\s\S]*?<\/footer>/g, '')
);
---

<Base
  title="Feedly Threat Intelligence: Collect, analyze, and share actionable intelligence"
  description="Be the first to know about emerging threats. Collect, analyze, and share open-source threat intelligence faster using AI."
>
  <Header />
  <Fragment set:html={body} />
  <Footer />
</Base>
