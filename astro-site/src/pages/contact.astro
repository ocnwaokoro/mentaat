---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site.js';
import '../styles/homepage.css';
import '../styles/congruent.css';

// Booking CTA is functional now (email) and auto-upgrades to the real scheduler the
// moment a real URL is set in site.bookingUrl (Calendly/Cal). Inline embed can replace
// the panel later by dropping the widget where the comment marks it.
const hasScheduler = site.bookingUrl && site.bookingUrl !== '#';
const bookHref = hasScheduler ? site.bookingUrl : `mailto:${site.email}?subject=Book%20a%20call`;

const head02white = 'Heading_heading__me6NI Heading_heading--02__GxsbA Heading_align--left__hNEzl Heading_color--white__5VAp3';
const head05white = 'Heading_heading__me6NI Heading_heading--05__4gkI8 Heading_align--left__hNEzl Heading_color--white__5VAp3';
const textWhite = 'Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--01__aiSyT Text_deprecatedMargin--none__sZLCS';
const textWhite2 = 'Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--02__HVmZN Text_deprecatedMargin--none__sZLCS';
const badge = 'Badge_badge__A7OHD Badge_color--accent__Vuh4G Badge_size--medium__MxotV';
const colL = 'Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Flex_gap--l__lrJk4';
const colS = 'Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Flex_gap--s__0656J';
const btnRow = 'Flex_flex___mzvZ Flex_align--center__9VuNC Flex_direction--row__W6CGY Flex_justify--start__vk9Tl ButtonRow_buttonRow__hs7qV Flex_gap--s__0656J';
const btnPrimary = 'BaseButton_button__S8cdB BaseButton_size--large__dpOfr BaseButton_importance--primary__1_2vI MarketingLinkButton_marketingLinkButton__n8FI4 BaseButton_color--accent-main__KBIuP FocusRing_focusRing__izyZU';
const btnSecondary = 'BaseButton_button__S8cdB BaseButton_size--large__dpOfr BaseButton_importance--secondary__qMmu3 MarketingLinkButton_marketingLinkButton__n8FI4 BaseButton_color--accent-main__KBIuP FocusRing_focusRing__izyZU';

const steps = [
  'You tell us where the business is getting stuck.',
  'We take a real look at how it runs.',
  'We tell you straight what we would build, and why.',
];
---

<Base
  title="Contact — Book a Call with Mentaat"
  description="Tell us what is slowing you down. We will tell you honestly whether and how we would build for it. No pitch, no pressure."
>
  <div id="__next">
    <div class="app_site--homepage__E5h5V app_loggedOut__HHvfJ">
      <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--space-between__LdB4V Layout_layout__u6BrU">
        <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Layout_content__q1d4E">
          <Header />
          <main class="Layout_main__nbmiJ index_layout__cD6cr cong">
            <div class="index_container__9GuY8">
              <div class="cong-stack">
                <div class="cong-card cong-card--dark theme--dark">
                  <div class="cong-hero">
                    <div class={colL}>
                      <span class={badge}>Contact</span>
                      <h1 class={head02white}>Let's take a look at your <em>operation</em></h1>
                      <p class={textWhite}>Tell us what is slowing you down. We will tell you, honestly, whether and how we would build for it. No pitch, no pressure.</p>
                      <div class={colS}>
                        {steps.map((s, i) => (
                          <p class={textWhite2}><em>{i + 1}.</em>&nbsp;&nbsp;{s}</p>
                        ))}
                      </div>
                    </div>

                    {/* Booking panel — drop the Calendly/Cal inline embed here later. */}
                    <div class="cong-card cong-card--white">
                      <div class={colS}>
                        <h2 class="Heading_heading__me6NI Heading_heading--05__4gkI8 Heading_align--left__hNEzl Heading_color--primary___QOq1">{hasScheduler ? 'Book your call' : 'Tell us what is slowing you down'}</h2>
                        <p class="Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--02__HVmZN Text_deprecatedMargin--none__sZLCS">Free, about 30 minutes. {hasScheduler ? 'Pick a time and you will get a short note on what to bring.' : 'Send a line about where the business is stuck and we will reply the same day with times.'}</p>
                        <div class={btnRow}>
                          <a href={bookHref} class={btnPrimary}><span>{hasScheduler ? 'Book a call' : 'Email us'}</span></a>
                          {hasScheduler && <a href={`mailto:${site.email}`} class={btnSecondary}><span>Email us</span></a>}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </main>
          <Footer />
        </div>
      </div>
    </div>
  </div>
</Base>
