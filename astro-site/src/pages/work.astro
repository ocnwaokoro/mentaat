---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { pageHtml } from '../html/work.js';
import { applyImageOverrides } from '../config/images.js';
import '../styles/work.css';

// Feedly's Customers/case-studies page, pulled clean from the live DOM, recolored via
// our tokens. Header/footer were stripped during extraction; our chrome wraps it.
// Rewrite Feedly's relative asset URLs to absolute so images/fonts still load for now.
const body = applyImageOverrides(
  pageHtml
    .replace(/(src|srcset)="\/_next\//g, '$1="https://feedly.com/_next/')
    .replace(/(src|srcset)="\/(?!\/)/g, '$1="https://feedly.com/')
);
---

<Base
  title="Our Work — Real Builds for Real Operations | Mentaat"
  description="A look at the operations we have gone into and what changed when we did. Real engagements across trades, healthcare, professional services, hospitality, and retail."
>
  <Header />
  <Fragment set:html={body} />
  <Footer />
</Base>
