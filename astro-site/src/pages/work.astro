---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
// Reuse the service-page vocabulary (Card grid, Heading, Text, Badge, Flex, BaseButton).
import '../styles/threat-intel.css';

// The 10 real engagements. Keystone-led, then Digital Products, then Workflow Intelligence.
// Anonymized by situation for now; a client name/logo drops in later without a rewrite.
const cases = [
  { tier: 'Keystone', hook: 'Quotes out the door in minutes, not days', who: 'A precision machine shop where every quote ran through one tired owner.', outcome: 'Three-day quotes became same-day. The owner got a day a week back.' },
  { tier: 'Keystone', hook: 'Never miss a lien deadline again', who: 'An electrical sub rebuilding pay apps in broken spreadsheets each month.', outcome: 'Billing went from two days to an afternoon. Zero missed deadlines since.' },
  { tier: 'Keystone', hook: 'One source of truth, not six spreadsheets', who: 'A two-location retailer that kept overselling online from a shared sheet.', outcome: 'Overselling stopped. Numbers they trust. Room to add a third location.' },
  { tier: 'Keystone', hook: 'The front desk stopped calling insurers', who: 'A family dental practice doing all benefit verification by hand.', outcome: 'Verification dropped from fifteen minutes to under two. No new hires.' },
  { tier: 'Digital Products', hook: 'Direct bookings the platforms used to own', who: 'A boutique hotel paying heavy commissions on a slow, dated site.', outcome: 'Direct bookings rose, each one avoiding a platform commission.' },
  { tier: 'Workflow Intelligence', hook: 'One coordinator, three times the closings', who: 'A brokerage capped by a single overwhelmed transaction coordinator.', outcome: 'Roughly tripled the closings one person could carry, with fewer slips.' },
  { tier: 'Workflow Intelligence', hook: 'The vet goes home with records done', who: 'A two-vet clinic drowning in after-hours charting and phones.', outcome: 'Charting moved into the visit. Missed calls dropped. Evenings back.' },
  { tier: 'Workflow Intelligence', hook: 'Every after-hours caller becomes a consult', who: 'A solo attorney losing cases to a phone that hit voicemail.', outcome: 'After-hours leads now convert instead of vanishing to the next firm.' },
  { tier: 'Workflow Intelligence', hook: 'Grant applications, a month to a week', who: 'A small nonprofit losing mission time to manual grant writing.', outcome: 'Application time fell from weeks to days. More applied for, more won.' },
  { tier: 'Workflow Intelligence', hook: 'Onboard a new client in an afternoon', who: 'A solo financial advisor buried in onboarding paperwork.', outcome: 'Onboarding went from days to an afternoon. More clients, same hours.' },
];

const cardClass = 'Card_card__S5Ka1 Card_size--default__WMqZP LandingCards_card__BVgmP';
---

<Base
  title="Our Work — Real Builds for Real Operations | Mentaat"
  description="A look at the operations we have gone into and what changed when we did. Real engagements across trades, healthcare, professional services, hospitality, and retail."
>
  <div id="__next">
    <div class="app_site--homepage__E5h5V app_loggedOut__HHvfJ">
      <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--space-between__LdB4V Layout_layout__u6BrU">
        <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Layout_content__q1d4E">
          <Header />
          <main class="Layout_main__nbmiJ index_layout__cD6cr">
            <div class="index_container__9GuY8">
              <div class="Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Flex_gap--xxl__mFPOt">

                <div class="Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Flex_gap--m__j4Ha1">
                  <h1 class="Heading_heading__me6NI Heading_heading--02__GxsbA Heading_align--left__hNEzl Heading_color--primary___QOq1">The work</h1>
                  <p class="Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--01__aiSyT Text_deprecatedMargin--none__sZLCS">
                    A look at the operations we go into, and what changes when we do. Find the one that sounds like your business.
                  </p>
                </div>

                <div class="Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--row__W6CGY Flex_justify--start__vk9Tl LandingCards_cards__BK9gg Flex_wrap__fR1jo">
                  {cases.map((c) => (
                    <div class={cardClass}>
                      <div class="Flex_flex___mzvZ Flex_align--center__9VuNC Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Flex_gap--s__0656J">
                        <span class="Badge_badge__A7OHD Badge_color--accent__Vuh4G Badge_size--medium__MxotV">{c.tier}</span>
                        <h2 class="Heading_heading__me6NI Heading_heading--05__4gkI8 Heading_align--center__FohI8 Heading_color--primary___QOq1">{c.hook}</h2>
                        <p class="Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--02__HVmZN Text_align--center___SIFC Text_deprecatedMargin--none__sZLCS">{c.who}</p>
                        <p class="Text_text__4F9CK Text_color--primary__thVpO Text_size--body--01__aiSyT Text_align--center___SIFC Text_deprecatedMargin--none__sZLCS">{c.outcome}</p>
                      </div>
                    </div>
                  ))}
                </div>

                <div class="Flex_flex___mzvZ Flex_align--center__9VuNC Flex_direction--row__W6CGY Flex_justify--start__vk9Tl ButtonRow_buttonRow__hs7qV Flex_gap--s__0656J">
                  <a href="/contact" class="BaseButton_button__S8cdB BaseButton_size--large__dpOfr BaseButton_importance--primary__1_2vI MarketingLinkButton_marketingLinkButton__n8FI4 BaseButton_color--accent-main__KBIuP FocusRing_focusRing__izyZU">
                    <span>Book a call</span>
                  </a>
                </div>

              </div>
            </div>
          </main>
        </div>
        <Footer />
      </div>
    </div>
  </div>
</Base>
