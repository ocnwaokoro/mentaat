---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/homepage.css';
import '../styles/congruent.css';

// Case-study detail template (congruent). Reusable shape: dark hero + result stats ->
// readable article (situation / what we built / outcome) -> CTA. One case for now.
const head02white = 'Heading_heading__me6NI Heading_heading--02__GxsbA Heading_align--left__hNEzl Heading_color--white__5VAp3';
const head05dark = 'Heading_heading__me6NI Heading_heading--05__4gkI8 Heading_align--left__hNEzl Heading_color--primary___QOq1';
const textWhite = 'Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--01__aiSyT Text_deprecatedMargin--none__sZLCS';
const textSec = 'Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--01__aiSyT Text_deprecatedMargin--none__sZLCS';
const badge = 'Badge_badge__A7OHD Badge_color--accent__Vuh4G Badge_size--medium__MxotV';
const colL = 'Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Flex_gap--l__lrJk4';
const colS = 'Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Flex_gap--s__0656J';
const btnRow = 'Flex_flex___mzvZ Flex_align--center__9VuNC Flex_direction--row__W6CGY Flex_justify--start__vk9Tl ButtonRow_buttonRow__hs7qV Flex_gap--s__0656J';
const btnPrimary = 'BaseButton_button__S8cdB BaseButton_size--large__dpOfr BaseButton_importance--primary__1_2vI MarketingLinkButton_marketingLinkButton__n8FI4 BaseButton_color--accent-main__KBIuP FocusRing_focusRing__izyZU';

const stats = [
  { num: 'Same day', label: 'quote turnaround, down from three days' },
  { num: 'A day a week', label: 'back for the owner' },
];
const sections = [
  { h: 'The situation', p: 'An eight-person, owner-operated precision machine shop quoted every job from customer drawings. Every quote ran through the owner, the one person who could read a print and price it right. Requests piled up for days, because quoting competed with running the floor, and a slow quote tells a customer the shop has no capacity. The pricing logic lived entirely in the owner\'s head.' },
  { h: 'What we built', p: 'We went in like an operator and mapped the whole quote-to-cash path. The bottleneck was the front office, not the machines. We built a quoting co-pilot that reads the incoming drawing, pulls the material, dimensions, and tolerances with the source shown for one-click checking, then matches the part against the shop\'s own prior quotes. It says, in effect, this looks like the job you ran last spring, at this price. The owner reviews and sends. Nothing auto-prices, because the owner\'s judgment is the product. We seeded it with two years of historical quotes so it spoke in the owner\'s own numbers from day one.' },
  { h: 'The outcome', p: 'Quote turnaround went from three days to same-day. The owner reclaimed roughly a day a week. Win rate rose, because fast, confident quotes beat slow ones. We did not replace the expert. We bottled the expert\'s instinct, so the business stops depending on one tired person at nine at night.' },
];
---

<Base
  title="Case Study: Same-Day Quotes for a Precision Machine Shop | Mentaat"
  description="How Mentaat went into a precision machine shop, found the bottleneck, and built the system that turned three-day quotes into same-day."
>
  <div id="__next">
    <div class="app_site--homepage__E5h5V app_loggedOut__HHvfJ">
      <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--space-between__LdB4V Layout_layout__u6BrU">
        <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Layout_content__q1d4E">
          <Header />
          <main class="Layout_main__nbmiJ index_layout__cD6cr cong">
            <div class="index_container__9GuY8">
              <div class="cong-stack">

                <div class="cong-card cong-card--dark theme--dark">
                  <div class={colL}>
                    <span class={badge}>Keystone Infrastructure</span>
                    <h1 class={head02white}>How a machine shop turned three-day quotes into <em>same-day</em></h1>
                    <p class={textWhite}>A precision machine shop handed us its whole quoting process. We went in, found the bottleneck, and built the system that fixed it.</p>
                    <div class="cong-stats">
                      {stats.map((s) => (
                        <div>
                          <span class="cong-stat-num">{s.num}</span>
                          <span class="cong-stat-label">{s.label}</span>
                        </div>
                      ))}
                    </div>
                    <div class={btnRow}>
                      <a href="/contact" class={btnPrimary}><span>Book a call</span></a>
                    </div>
                  </div>
                </div>

                <div class="cong-article cong-article-group">
                  {sections.map((s) => (
                    <div class={colS}>
                      <h2 class={head05dark}>{s.h}</h2>
                      <p class={textSec}>{s.p}</p>
                    </div>
                  ))}
                </div>

                <div class="cong-card cong-card--dark theme--dark cong-center">
                  <div class={`${colL} cong-cta-center`}>
                    <h2 class={head02white}>Want this kind of leverage in <em>your operation</em>?</h2>
                    <p class={textWhite}>Tell us where the business is stuck. We will take a real look and tell you straight what we would build, and why.</p>
                    <div class={btnRow}>
                      <a href="/contact" class={btnPrimary}><span>Book a call</span></a>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </main>
          <Footer />
        </div>
      </div>
    </div>
  </div>
</Base>
