---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/homepage.css';
import '../styles/service.css';

const services = [
  {
    n: '01', eyebrow: '// 01 — Digital Products', href: '/services/web-development',
    h: 'Websites and web apps that bring in <em>work</em>',
    p: 'Fast, modern sites built around how you actually win customers, and simple enough to run yourself.',
    ph: '// digital products', tone: 'light',
  },
  {
    n: '02', eyebrow: '// 02 — Workflow Intelligence', href: '/services/ai-automation',
    h: 'AI woven into how your team <em>already works</em>',
    p: 'We embed, learn your real process, and automate the busywork that eats your team\'s day.',
    ph: '// workflow intelligence', tone: 'dark',
  },
  {
    n: '03', eyebrow: '// 03 — Keystone Infrastructure', href: '/services/custom-software',
    h: 'Custom systems your whole operation <em>runs on</em>',
    p: 'We come in like an operator, find the leverage, and build what the business actually needs.',
    ph: '// keystone infrastructure', tone: 'light',
  },
];
---

<Base
  title="Services — Engineering & AI for Boutique Businesses | Mentaat"
  description="Three ways we go in and build: Digital Products (web development), Workflow Intelligence (AI automation), and Keystone Infrastructure (custom software and operations engineering)."
>
  <div id="__next">
    <div class="app_site--homepage__E5h5V app_loggedOut__HHvfJ">
      <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--space-between__LdB4V Layout_layout__u6BrU">
        <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Layout_content__q1d4E">
          <Header />
          <main class="svc">

            <section class="svc-band svc-band--dark svc-hero">
              <div class="svc-inner">
                <div>
                  <span class="svc-eyebrow">// Services</span>
                  <h1 class="svc-h1">Three ways we go in <em>and build</em></h1>
                  <p class="svc-sub">Not sure which you need? Most engagements start with a single call and grow from there. Pick the one that sounds like your business, or just book the call.</p>
                  <div class="svc-cta-row">
                    <a href="/contact" class="svc-btn svc-btn--primary">Book a call</a>
                    <a href="/work" class="svc-btn svc-btn--ghost">See our work</a>
                  </div>
                </div>
                <div class="svc-ph svc-ph--hero" data-label="// the studio"></div>
              </div>
            </section>

            {services.map((s, i) => (
              <section class={'svc-band svc-band--' + s.tone}>
                <div class="svc-inner">
                  <div class={'svc-feature' + (i % 2 === 1 ? ' svc-feature--flip' : '')}>
                    <div class="svc-feature-text">
                      <span class="svc-eyebrow">{s.eyebrow}</span>
                      <h2 class="svc-feature-h" set:html={s.h} />
                      <p class="svc-feature-p">{s.p}</p>
                      <a href={s.href} class="svc-link">Explore →</a>
                    </div>
                    <div class="svc-ph svc-feature-img" data-label={s.ph}></div>
                  </div>
                </div>
              </section>
            ))}

            <section class="svc-band svc-band--dark svc-cta">
              <div class="svc-inner">
                <h2 class="svc-cta-head">Not sure where to <em>start</em>?</h2>
                <p class="svc-cta-sub">Tell us where the business is stuck. We will point you to the right one, or tell you straight if it is not us.</p>
                <div class="svc-cta-row">
                  <a href="/contact" class="svc-btn svc-btn--primary">Book a call</a>
                </div>
              </div>
            </section>

          </main>
          <Footer />
        </div>
      </div>
    </div>
  </div>
</Base>
