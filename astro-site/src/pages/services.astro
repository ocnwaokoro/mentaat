---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Tile from '../components/Tile.astro';
import Footer from '../components/Footer.astro';
import { tileImages } from '../config/images.js';
import '../styles/homepage.css';
---

<Base
  title="Services — Engineering & AI for Boutique Businesses | Mentaat"
  description="Three ways we go in and build: Digital Products (web development), Workflow Intelligence (AI automation), and Keystone Infrastructure (custom software and operations engineering)."
>
  <div id="__next">
    <div class="app_site--homepage__E5h5V app_loggedOut__HHvfJ">
      <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--space-between__LdB4V Layout_layout__u6BrU">
        <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Layout_content__q1d4E">
          <Header />
          <main class="Layout_main__nbmiJ index_layout__cD6cr">
            <div class="Flex_flex___mzvZ Flex_align--center__9VuNC Flex_direction--row__W6CGY Flex_justify--start__vk9Tl index_container__9GuY8 Flex_gap--m__j4Ha1">
              <Tile
                badge="Build"
                titleHtml="Digital<br />Products"
                description="Modern websites and web apps, built to perform."
                primaryHref="/services/web-development"
                primaryLabel="Explore"
                secondaryHref="/contact"
                secondaryLabel="Book a call"
                imageSrc={tileImages.digitalProducts}
                imageAlt="A modern web product built by Mentaat."
                theme="dark"
              />
              <Tile
                badge="Embed"
                titleHtml="Workflow<br />Intelligence"
                description="We embed with your team, learn how you really work, and weave AI into it."
                primaryHref="/services/ai-automation"
                primaryLabel="Explore"
                secondaryHref="/contact"
                secondaryLabel="Book a call"
                imageSrc={tileImages.workflowIntelligence}
                imageAlt="An AI-assisted workflow built into a team's existing tools."
                theme="light"
              />
              <Tile
                badge="Transform"
                titleHtml="Keystone<br />Infrastructure"
                description="We go in like an operator, find the leverage, and build the systems that scale you."
                primaryHref="/services/custom-software"
                primaryLabel="Explore"
                secondaryHref="/contact"
                secondaryLabel="Book a call"
                imageSrc={tileImages.keystoneInfrastructure}
                imageAlt="A custom operations system built for a small business."
                theme="white"
              />
            </div>
          </main>
        </div>
        <Footer />
      </div>
    </div>
  </div>
</Base>
