---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/homepage.css';
import '../styles/congruent.css';

const head02white = 'Heading_heading__me6NI Heading_heading--02__GxsbA Heading_align--left__hNEzl Heading_color--white__5VAp3';
const headTitleDark = 'Heading_heading__me6NI Heading_heading--02__GxsbA Heading_align--left__hNEzl Heading_color--primary___QOq1';
const textWhite = 'Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--02__HVmZN Text_deprecatedMargin--none__sZLCS';
const badgeAccent = 'Badge_badge__A7OHD Badge_color--accent__Vuh4G Badge_size--medium__MxotV';
const badgeGray = 'Badge_badge__A7OHD Badge_color--gray__pkQCI Badge_size--medium__MxotV';
const colL = 'Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Flex_gap--l__lrJk4';
const btnRow = 'Flex_flex___mzvZ Flex_align--center__9VuNC Flex_direction--row__W6CGY Flex_justify--start__vk9Tl ButtonRow_buttonRow__hs7qV Flex_gap--s__0656J';
const btnPrimary = 'BaseButton_button__S8cdB BaseButton_size--large__dpOfr BaseButton_importance--primary__1_2vI MarketingLinkButton_marketingLinkButton__n8FI4 BaseButton_color--accent-main__KBIuP FocusRing_focusRing__izyZU';

const services = [
  { surface: 'dark',  eyebrow: 'Build',     title: 'Digital Products',       href: '/services/web-development',
    p: 'Modern websites and web apps, built to perform.', img: '/work/boutique-hotel.jpg' },
  { surface: 'tint',  eyebrow: 'Embed',     title: 'Workflow Intelligence',  href: '/services/ai-automation',
    p: 'We learn how your team really works, then use AI to take the busywork off their plate.', img: '/work/dental-verification.jpg' },
  { surface: 'white', eyebrow: 'Transform', title: 'Keystone Infrastructure', href: '/services/custom-software',
    p: 'We get into your business and build the custom software it runs on.', img: '/work/machine-shop-quoting.jpg' },
];
---

<Base
  title="Services — Engineering & AI for Boutique Businesses | Mentaat"
  description="Three ways we get to work: Digital Products (web development), Workflow Intelligence (AI automation), and Keystone Infrastructure (custom software and operations engineering)."
>
  <div id="__next">
    <div class="app_site--homepage__E5h5V app_loggedOut__HHvfJ">
      <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--space-between__LdB4V Layout_layout__u6BrU">
        <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Layout_content__q1d4E">
          <Header />
          <main class="Layout_main__nbmiJ index_layout__cD6cr cong">

            {/* HERO — full-bleed beam */}
            <section class="cong-band theme--dark cs-herowrap">
              <div class="cong-band-inner">
                <div class={colL}>
                  <h1 class={head02white}>Three ways we <em>get to work</em></h1>
                  <p class="cs-lede">Not sure which you need? Most engagements start with a single call and grow from there. Pick the one that sounds like your business.</p>
                </div>
              </div>
            </section>

            {/* SERVICE CARDS — homepage-tile style, image on top */}
            <div class="index_container__9GuY8 cong-svc-body">
              <div class="cong-row3">
                {services.map((s) => {
                  const dark = s.surface === 'dark';
                  return (
                    <a href={s.href} class={`cong-card cong-card--${s.surface}${dark ? ' theme--dark' : ''} cong-svc-card`}>
                      <div class="cong-svc-img"><img src={s.img} alt="" loading="lazy" /></div>
                      <div class="cong-svc-body2">
                        <span class={s.surface === 'white' ? badgeGray : badgeAccent}>{s.eyebrow}</span>
                        <h2 class={dark ? head02white : headTitleDark}>{s.title}</h2>
                        <p class={textWhite}>{s.p}</p>
                        <span class="cong-svc-more">Learn more</span>
                      </div>
                    </a>
                  );
                })}
              </div>
            </div>

            {/* CTA — full-bleed beam */}
            <section class="cong-band theme--dark cs-herowrap cong-center">
              <div class="cong-band-inner">
                <div class={`${colL} cong-cta-center`}>
                  <h2 class={head02white}>Not sure where to <em>start</em>?</h2>
                  <p class="cs-lede">Tell us where the business is stuck. We will point you to the right one, or tell you straight if it is not us.</p>
                  <div class={btnRow}>
                    <a href="/contact" class={btnPrimary}><span>Book a call</span></a>
                  </div>
                </div>
              </div>
            </section>

          </main>
          <Footer />
        </div>
      </div>
    </div>
  </div>
</Base>
