---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Tile from '../components/Tile.astro';
import Footer from '../components/Footer.astro';
import { tileImages } from '../config/images.js';
import '../styles/homepage.css';
import '../styles/service.css';
---

<Base
  title="Mentaat — Engineering & AI for Boutique Businesses"
  description="We go into your operation, find the leverage, and build the systems and AI that make it run better. A forward-deployed engineering and AI studio for boutique businesses."
>
  <div id="__next">
    <div class="app_site--homepage__E5h5V app_loggedOut__HHvfJ">
      <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--space-between__LdB4V Layout_layout__u6BrU">
        <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Layout_content__q1d4E">
          <Header />
          <main class="Layout_main__nbmiJ index_layout__cD6cr">
            <div class="svc">
              <section class="svc-band svc-band--dark svc-hero svc-hero--solo">
                <div class="svc-inner">
                  <div>
                    <span class="svc-eyebrow">// Forward-deployed engineering + AI</span>
                    <h1 class="svc-h1">We build the systems your business runs on, and the <em>intelligence</em> that runs them better</h1>
                    <p class="svc-sub">Websites, AI automation, and custom software for boutique businesses. We embed like an operator, find the leverage, and build it, then stay until it works.</p>
                    <div class="svc-cta-row">
                      <a href="/contact" class="svc-btn svc-btn--primary">Book a call</a>
                      <a href="/work" class="svc-btn svc-btn--ghost">See the work</a>
                    </div>
                  </div>
                </div>
              </section>
            </div>
            <div class="Flex_flex___mzvZ Flex_align--center__9VuNC Flex_direction--row__W6CGY Flex_justify--start__vk9Tl index_container__9GuY8 Flex_gap--m__j4Ha1">
              <Tile
                badge="Build"
                titleHtml="Digital<br />Products"
                description="Modern websites and web apps, built to perform."
                primaryHref="/work"
                primaryLabel="See the work"
                secondaryHref="/services/web-development"
                secondaryLabel="Explore"
                imageSrc={tileImages.digitalProducts}
                imageAlt="A modern web product built by Mentaat."
                theme="dark"
              />
              <Tile
                badge="Embed"
                titleHtml="Workflow<br />Intelligence"
                description="We embed with your team, learn how you really work, and weave AI into it."
                primaryHref="/contact"
                primaryLabel="Book a call"
                secondaryHref="/services/ai-automation"
                secondaryLabel="Explore"
                imageSrc={tileImages.workflowIntelligence}
                imageAlt="An AI-assisted workflow built into a team's existing tools."
                theme="light"
              />
              <Tile
                badge="Transform"
                titleHtml="Keystone<br />Infrastructure"
                description="We go in like an operator, find the leverage, and build the systems that scale you."
                primaryHref="/contact"
                primaryLabel="Book a call"
                secondaryHref="/services/custom-software"
                secondaryLabel="Explore"
                imageSrc={tileImages.keystoneInfrastructure}
                imageAlt="A custom operations system built for a small business."
                theme="white"
              />
            </div>
          </main>
        </div>
        <Footer />
      </div>
    </div>
  </div>
</Base>
