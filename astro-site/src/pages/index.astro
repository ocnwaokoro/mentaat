---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Tile from '../components/Tile.astro';
import LogoSection from '../components/LogoSection.astro';
import Footer from '../components/Footer.astro';
import { tileImages } from '../config/images.js';
import '../styles/homepage.css';
---

<Base
  title="Feedly: Track the topics and trends that matter to you"
  description="Collect, analyze, and share actionable open source threat intelligence, market intelligence, and the news that matters — faster, with AI."
>
  <div id="__next">
    <div class="app_site--homepage__E5h5V app_loggedOut__HHvfJ">
      <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--space-between__LdB4V Layout_layout__u6BrU">
        <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Layout_content__q1d4E">
          <Header />
          <main class="Layout_main__nbmiJ index_layout__cD6cr">
            <div class="Flex_flex___mzvZ Flex_align--center__9VuNC Flex_direction--row__W6CGY Flex_justify--start__vk9Tl index_container__9GuY8 Flex_gap--m__j4Ha1">
              <Tile
                badge="Build"
                titleHtml="Digital<br />Products"
                description="Modern websites and web apps, built to perform."
                primaryHref="https://feedly.com/signup?gate=%2Fhomepage&workEmail=false"
                primaryLabel="Get Started for Free"
                secondaryHref="/threat-intel"
                secondaryLabel="Learn More"
                imageSrc={tileImages.digitalProducts}
                imageAlt="Illustration of an article about cyberattacks and ransomware. AI has identified a CVSS score of 8.5, 8 IoCs, and 6 TTPs."
                theme="dark"
              />
              <Tile
                badge="Embed"
                titleHtml="Workflow<br />Intelligence"
                description="AI woven into the way your team already works."
                primaryHref="https://feedly.com/market-intelligence/request-trial?gate=%2Fhomepage"
                primaryLabel="Get Started for Free"
                secondaryHref="/market-intel"
                secondaryLabel="Learn More"
                imageSrc={tileImages.workflowIntelligence}
                imageAlt="Illustration of an article about a product launch in the finance industry. A tooltip points out an AI Summary and an icon to “save to board”"
                theme="light"
              />
              <Tile
                badge="Transform"
                titleHtml="Keystone<br />Infrastructure"
                description="Operational analysis and build out, end to end."
                primaryHref="https://feedly.com/i/newAccountSetup?accountType=Personal&gate=%2Fhomepage"
                primaryLabel="Get Started for Free"
                secondaryHref="/news-reader"
                secondaryLabel="Learn More"
                imageSrc={tileImages.keystoneInfrastructure}
                imageAlt="A screenshot of the Feedly news reader interface showing the “Today” page and a list of articles."
                theme="white"
              />
            </div>
            <LogoSection />
          </main>
        </div>
        <Footer />
      </div>
    </div>
  </div>
</Base>
