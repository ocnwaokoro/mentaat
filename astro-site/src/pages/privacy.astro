---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/homepage.css';
import '../styles/legal.css';

// Mentaat's own Privacy Policy, composed from existing design-system component
// classes plus a small scoped legal.css for the reading-column layout.

const headingClass = 'Heading_heading__me6NI Heading_heading--05__4gkI8 Heading_align--left__hNEzl Heading_color--primary___QOq1';
const textClass = 'Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--01__aiSyT';

const sections = [
  {
    id: 'information-we-collect',
    title: 'Information we collect',
    body: [
      'When you contact us, book a call, or fill out a form on this site, we collect what you provide, such as your name, business, email address, and anything you write to us. Like most websites, we may also collect basic technical and usage data, such as IP address, browser type, and pages visited, through cookies and analytics.',
    ],
  },
  {
    id: 'how-we-use-it',
    title: 'How we use it',
    body: [
      'We use this information to respond to you, schedule and prepare for conversations, provide and improve our services, and operate and secure the site. We do not sell your personal information.',
    ],
  },
  {
    id: 'who-we-share-it-with',
    title: 'Who we share it with',
    body: [
      'We share information only with service providers who help us operate the site and our business, such as hosting, email, scheduling, and analytics providers, and only as needed to do that work. We never sell your personal information. We may disclose information if required by law.',
    ],
  },
  {
    id: 'cookies-and-analytics',
    title: 'Cookies and analytics',
    body: [
      'This site uses cookies for basic functionality and, where enabled, for analytics that help us understand how the site is used. You can control cookies through your browser settings.',
    ],
  },
  {
    id: 'data-retention',
    title: 'Data retention',
    body: [
      'We keep your information for as long as needed to respond to you and run our business, then delete or anonymize it.',
    ],
  },
  {
    id: 'your-rights',
    title: 'Your rights',
    body: [
      'You may ask us to access, correct, or delete the personal information you have given us by emailing hello@mentaat.com. We use reasonable measures to protect your information, though no method of transmission or storage is perfectly secure. This site is not directed to children under 13, and we do not knowingly collect their information.',
    ],
  },
  {
    id: 'changes-to-this-policy',
    title: 'Changes to this policy',
    body: [
      'We may update this policy. The effective date above will reflect the latest version.',
    ],
  },
  {
    id: 'how-to-contact-us',
    title: 'How to contact us',
    body: [
      'Questions about this policy can be sent to hello@mentaat.com. Mentaat Technologies LLC, New Jersey.',
    ],
  },
];
---

<Base
  title="Privacy Policy | Mentaat"
  description="How Mentaat collects, uses, and protects information through this website."
>
  <div id="__next">
    <div class="app_site--homepage__E5h5V app_loggedOut__HHvfJ">
      <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--space-between__LdB4V Layout_layout__u6BrU">
        <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Layout_content__q1d4E">
          <Header />
          <main class="legal">
            <div class="legal__container">
              <header class="legal__header">
                <span class="Badge_badge__A7OHD Badge_color--accent__Vuh4G Badge_size--medium__MxotV">Legal</span>
                <h1 class="Heading_heading__me6NI Heading_heading--02__GxsbA Heading_align--left__hNEzl Heading_color--primary___QOq1">Privacy Policy</h1>
                <p class="Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--02__HVmZN">Effective date: June 27, 2026</p>
              </header>

              <div class="legal__body">
                <nav class="legal__toc" aria-label="Sections">
                  <ol>
                    {sections.map((section, i) => (
                      <li>
                        <a class={textClass} href={`#${section.id}`}>{i + 1}. {section.title}</a>
                      </li>
                    ))}
                  </ol>
                </nav>

                <div class="legal__content">
                  <p class={textClass}>Mentaat Technologies LLC ("Mentaat," "we," "us") is a New Jersey software and AI consulting studio. We respect your privacy. This policy explains what we collect through this website, how we use it, and your choices.</p>

                  {sections.map((section, i) => (
                    <section class="legal__section" id={section.id}>
                      <h2 class={headingClass}>{i + 1}. {section.title}</h2>
                      {section.body.map((para) => (
                        <p class={textClass}>{para}</p>
                      ))}
                    </section>
                  ))}

                  <p class={`legal__contact ${textClass}`}>Questions? Email <a href="mailto:hello@mentaat.com">hello@mentaat.com</a>.</p>
                </div>
              </div>
            </div>
          </main>
          <Footer />
        </div>
      </div>
    </div>
  </div>
</Base>
