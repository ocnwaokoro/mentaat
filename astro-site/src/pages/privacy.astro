---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { pageHtml } from '../html/privacy.js';
import '../styles/work.css';

// Legal page layout (Feedly's, live-extracted), reskinned via our tokens, our chrome.
// PLACEHOLDER content: swap for Mentaat's reviewed Privacy Policy before launch.
const body = pageHtml
  .replace(/(src|srcset)="\/_next\//g, '$1="https://feedly.com/_next/')
  .replace(/(src|srcset)="\/(?!\/)/g, '$1="https://feedly.com/');
---

<Base title="Privacy Policy | Mentaat" description="Mentaat privacy policy.">
  <Header />
  <Fragment set:html={body} />
  <Footer />
</Base>
