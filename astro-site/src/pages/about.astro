---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/homepage.css';
import '../styles/service.css';

const sections = [
  { eyebrow: '// What forward-deployed means', h: 'We work the way an operator would', p: 'We sit with how your business actually runs, the quoting, the scheduling, the billing, the follow-up, and we find the one bottleneck that everything else waits on. Then we build for that, and we <em>stay until it works</em>.' },
  { eyebrow: '// Who we build for', h: 'Boutique businesses, where one capable person is the bottleneck', p: 'The machine shop, the dental practice, the boutique hotel, the brokerage, the solo attorney. The places where a well-built system gives someone their week back, and the business room to grow.' },
  { eyebrow: '// How we work', h: 'Three ways in, and most engagements grow', p: 'Digital Products when you need a website or web app that performs. Workflow Intelligence when a process should be running with AI inside it. Keystone Infrastructure when the whole operation needs an operator to come in, diagnose, and build.' },
  { eyebrow: '// Where we are', h: 'Based in New Jersey, and we come to you', p: 'Forward-deployed means we show up and build alongside you, not over email. Local enough to sit at your table, and built to ship.' },
];
---

<Base
  title="About Mentaat — Forward-Deployed Engineering & AI in New Jersey"
  description="Mentaat is a forward-deployed engineering and AI studio for boutique businesses. We go into your operation, find the leverage, and build the system that changes it."
>
  <div id="__next">
    <div class="app_site--homepage__E5h5V app_loggedOut__HHvfJ">
      <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--space-between__LdB4V Layout_layout__u6BrU">
        <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Layout_content__q1d4E">
          <Header />
          <main class="svc">

            <section class="svc-band svc-band--dark svc-hero">
              <div class="svc-inner">
                <div>
                  <span class="svc-eyebrow">// About Mentaat</span>
                  <h1 class="svc-h1">We go in like an <em>operator</em>, not a vendor</h1>
                  <p class="svc-sub">Mentaat is a forward-deployed engineering and AI studio for boutique businesses. We do not hand you a tool and wish you luck. We go into your operation, find where the leverage is, and build the system that changes it.</p>
                  <div class="svc-cta-row">
                    <a href="/contact" class="svc-btn svc-btn--primary">Book a call</a>
                    <a href="/work" class="svc-btn svc-btn--ghost">See the work</a>
                  </div>
                </div>
                <div class="svc-ph svc-ph--hero" data-label="// the studio"></div>
              </div>
            </section>

            <section class="svc-band svc-band--light">
              <div class="svc-inner">
                <div class="svc-prose svc-prose-group">
                  {sections.map((s) => (
                    <div>
                      <span class="svc-eyebrow">{s.eyebrow}</span>
                      <h2>{s.h}</h2>
                      <p set:html={s.p} />
                    </div>
                  ))}
                </div>
              </div>
            </section>

            <section class="svc-band svc-band--dark svc-cta">
              <div class="svc-inner">
                <h2 class="svc-cta-head">Let us find the leverage in <em>your operation</em></h2>
                <p class="svc-cta-sub">Tell us where the business is stuck. We will take a real look and tell you straight what we would build, and why.</p>
                <div class="svc-cta-row">
                  <a href="/contact" class="svc-btn svc-btn--primary">Book a call</a>
                </div>
              </div>
            </section>

          </main>
          <Footer />
        </div>
      </div>
    </div>
  </div>
</Base>
