---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/homepage.css';

const heading = 'Heading_heading__me6NI Heading_heading--02__GxsbA Heading_align--left__hNEzl Heading_color--primary___QOq1';
const subhead = 'Heading_heading__me6NI Heading_heading--05__4gkI8 Heading_align--left__hNEzl Heading_color--primary___QOq1';
const para = 'Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--01__aiSyT Text_deprecatedMargin--none__sZLCS';
const group = 'Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Flex_gap--s__0656J';
---

<Base
  title="About Mentaat — Forward-Deployed Engineering & AI in New Jersey"
  description="Mentaat is a forward-deployed engineering and AI studio for boutique businesses. We go into your operation, find the leverage, and build the system that changes it."
>
  <div id="__next">
    <div class="app_site--homepage__E5h5V app_loggedOut__HHvfJ">
      <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--space-between__LdB4V Layout_layout__u6BrU">
        <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Layout_content__q1d4E">
          <Header />
          <main class="Layout_main__nbmiJ index_layout__cD6cr">
            <div class="index_container__9GuY8">
              <div class="Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Flex_gap--xxl__mFPOt">

                <div class={group}>
                  <h1 class={heading}>About Mentaat</h1>
                  <p class={para}>
                    Mentaat is a forward-deployed engineering and AI studio for boutique businesses. We do not hand you a tool and wish you luck. We go into your operation, find where the leverage is, and build the system that changes it.
                  </p>
                </div>

                <div class={group}>
                  <h2 class={subhead}>What forward-deployed means</h2>
                  <p class={para}>
                    We work the way an operator would. We sit with how your business actually runs, the quoting, the scheduling, the billing, the follow-up, and we find the one bottleneck that everything else waits on. Then we build for that, and we stay until it works.
                  </p>
                </div>

                <div class={group}>
                  <h2 class={subhead}>Who we build for</h2>
                  <p class={para}>
                    Small and boutique businesses: the machine shop, the dental practice, the boutique hotel, the brokerage, the solo attorney. The places where one capable person is the bottleneck, and a well-built system gives them their week back.
                  </p>
                </div>

                <div class={group}>
                  <h2 class={subhead}>How we work</h2>
                  <p class={para}>
                    Three ways in. Digital Products when you need a website or web app that performs. Workflow Intelligence when you have a process that should be running with AI inside it. Keystone Infrastructure when the whole operation needs an operator to come in, diagnose, and build. Most engagements start with one and grow.
                  </p>
                </div>

                <div class={group}>
                  <h2 class={subhead}>Where we are</h2>
                  <p class={para}>
                    Based in New Jersey, working with businesses that want someone who will actually show up and build.
                  </p>
                </div>

                <div class="Flex_flex___mzvZ Flex_align--center__9VuNC Flex_direction--row__W6CGY Flex_justify--start__vk9Tl ButtonRow_buttonRow__hs7qV Flex_gap--s__0656J">
                  <a href="/contact" class="BaseButton_button__S8cdB BaseButton_size--large__dpOfr BaseButton_importance--primary__1_2vI MarketingLinkButton_marketingLinkButton__n8FI4 BaseButton_color--accent-main__KBIuP FocusRing_focusRing__izyZU">
                    <span>Book a call</span>
                  </a>
                </div>

              </div>
            </div>
          </main>
        </div>
        <Footer />
      </div>
    </div>
  </div>
</Base>
