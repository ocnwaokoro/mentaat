---
import Base from '../layouts/Base.astro';
import { site } from '../config/site.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/homepage.css';
import '../styles/congruent.css';

const head02white = 'Heading_heading__me6NI Heading_heading--02__GxsbA Heading_align--left__hNEzl Heading_color--white__5VAp3';
const head05dark = 'Heading_heading__me6NI Heading_heading--05__4gkI8 Heading_align--left__hNEzl Heading_color--primary___QOq1';
const textSec = 'Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--01__aiSyT Text_deprecatedMargin--none__sZLCS';
const badge = 'Badge_badge__A7OHD Badge_color--accent__Vuh4G Badge_size--medium__MxotV';
const colL = 'Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Flex_gap--l__lrJk4';
const colS = 'Flex_flex___mzvZ Flex_align--start__Nb_Sy Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Flex_gap--s__0656J';
const btnRow = 'Flex_flex___mzvZ Flex_align--center__9VuNC Flex_direction--row__W6CGY Flex_justify--start__vk9Tl ButtonRow_buttonRow__hs7qV Flex_gap--s__0656J';
const btnPrimary = 'BaseButton_button__S8cdB BaseButton_size--large__dpOfr BaseButton_importance--primary__1_2vI MarketingLinkButton_marketingLinkButton__n8FI4 BaseButton_color--accent-main__KBIuP FocusRing_focusRing__izyZU';
const btnSecondary = 'BaseButton_button__S8cdB BaseButton_size--large__dpOfr BaseButton_importance--secondary__qMmu3 MarketingLinkButton_marketingLinkButton__n8FI4 BaseButton_color--accent-main__KBIuP FocusRing_focusRing__izyZU';

const sections = [
  { h: 'What it means that we come to you', p: 'We sit with how your business actually runs, the quoting, the scheduling, the billing, the follow-up, and we find the one bottleneck that everything else waits on. Then we build for that, and we <em>stay until it works</em>.' },
  { h: 'Who we build for', p: 'The machine shop, the dental practice, the boutique hotel, the brokerage, the solo attorney. The places where one capable person is the bottleneck, and a well-built system gives them their week back.' },
  { h: 'How we work', p: 'Digital Products when you need a website or web app that performs. Workflow Intelligence when a process should be running with AI inside it. Keystone Infrastructure when the whole operation needs someone to come in, diagnose, and build.' },
  { h: 'Where we are', p: 'Based in New Jersey, and we come to you. It means we show up and build alongside you, not over email.' },
];
---

<Base
  title="About Mentaat — Engineering & AI in New Jersey"
  description="Mentaat is an engineering and AI studio for boutique businesses, and we come to you. We find the one thing slowing you down and build the system that changes it."
>
  <div id="__next">
    <div class="app_site--homepage__E5h5V app_loggedOut__HHvfJ">
      <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--space-between__LdB4V Layout_layout__u6BrU">
        <div class="Flex_flex___mzvZ Flex_direction--column__TTxLV Flex_justify--start__vk9Tl Layout_content__q1d4E">
          <Header />
          <main class="Layout_main__nbmiJ index_layout__cD6cr cong">
            <section class="cong-band theme--dark cs-herowrap cong-hero-solo">
              <div class="cong-band-inner">
                <div class={colL}>
                  <span class={badge}>About Mentaat</span>
                  <h1 class={head02white}>We get right into your <em>business</em>, not just hand you a tool</h1>
                  <p class="cs-lede">We do not hand you a tool and wish you luck. We get into your business, find the one thing slowing you down, and build the system that changes it.</p>
                  <div class={btnRow}>
                    <a href={site.bookingUrl} target="_blank" rel="noopener" class={btnPrimary}><span>Book a call</span></a>
                    <a href="/work" class={btnSecondary}><span>See the work</span></a>
                  </div>
                </div>
              </div>
            </section>

            <div class="index_container__9GuY8 cong-svc-body">
              <div class="cs-body cong-about-cs">
                {sections.map((s) => (
                  <div class="cs-block">
                    <div class="cs-block-label">{s.h}</div>
                    <p class={textSec} set:html={s.p} />
                  </div>
                ))}
              </div>
            </div>

            <section class="cong-band theme--dark cs-herowrap cong-center">
              <div class="cong-band-inner">
                <div class={`${colL} cong-cta-center`}>
                  <h2 class={head02white}>Let us find the one thing slowing you down in <em>your operation</em></h2>
                  <p class="Text_text__4F9CK Text_color--secondary__oRE1u Text_size--body--01__aiSyT Text_deprecatedMargin--none__sZLCS">Tell us where the business is stuck. We will take a real look and tell you straight what we would build, and why.</p>
                  <div class={btnRow}>
                    <a href={site.bookingUrl} target="_blank" rel="noopener" class={btnPrimary}><span>Book a call</span></a>
                  </div>
                </div>
              </div>
            </section>
          </main>
          <Footer />
        </div>
      </div>
    </div>
  </div>
</Base>
