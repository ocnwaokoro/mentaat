---
// Base layout — the SEO-friendly <head> the old React SPA never had.
// Every page is pre-rendered to static HTML, so crawlers/social scrapers get
// real content + meta tags, not an empty #root.
import '../styles/tokens.css';
// Re-skin experimentation layer: overrides token values on top of the baseline.
// Empty = baseline (Feedly green). Swap in a candidate to preview a palette.
import '../styles/active-theme.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '../config/site.js';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Mentaat — Forward-Deployed Engineering & AI for Boutique Businesses',
  description = site.tagline,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.domain).href;
const ogImage = new URL(site.ogImage, site.domain).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/assets/mentaat-favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': 'https://mentaat.com/#organization',
          name: 'Mentaat',
          url: 'https://mentaat.com',
          email: 'hello@mentaat.com',
          description: 'A forward-deployed engineering and AI studio for boutique businesses',
          areaServed: 'New Jersey',
          address: {
            '@type': 'PostalAddress',
            addressRegion: 'New Jersey',
            addressCountry: 'US',
          },
          makesOffer: [
            {
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Service',
                name: 'Web development and digital products',
              },
            },
            {
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Service',
                name: 'AI workflow automation',
              },
            },
            {
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Service',
                name: 'Custom software and operations engineering',
              },
            },
          ],
        },
        {
          '@type': 'WebSite',
          '@id': 'https://mentaat.com/#website',
          url: 'https://mentaat.com',
          name: 'Mentaat',
          description: 'A forward-deployed engineering and AI studio for boutique businesses',
          publisher: { '@id': 'https://mentaat.com/#organization' },
        },
      ],
    })} />
    <ClientRouter />
    <style is:global>
      /* Auto scroll-reveal — only with motion preference; if JS is off, nothing hides */
      @media (prefers-reduced-motion: no-preference) {
        [data-reveal] { opacity: 0; transform: translateY(18px); transition: opacity .55s ease, transform .55s cubic-bezier(.22,.61,.36,1); }
        [data-reveal].is-visible { opacity: 1; transform: none; }
      }
    </style>
  </head>
  <body>
    <slot />
    <script>
      function initReveal() {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        // Only section-level blocks reveal — never individual grid cards (so a card grid
        // can never be left partially hidden if the observer misses one).
        const sel = '.cong-home-hero, .cong-page-hero, .cong-statement, .cong-sec';
        const els = [...document.querySelectorAll(sel)];
        const reveal = (el) => el.classList.add('is-visible');
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { reveal(e.target); io.unobserve(e.target); } });
        }, { threshold: 0.04, rootMargin: '0px 0px -6% 0px' });
        els.forEach((el) => { el.setAttribute('data-reveal', ''); io.observe(el); });
        // FAILSAFE: whatever happens, reveal everything after a beat so content is never lost.
        setTimeout(() => els.forEach(reveal), 1400);
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
