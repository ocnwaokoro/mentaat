---
// Base layout — the SEO-friendly <head> the old React SPA never had.
// Every page is pre-rendered to static HTML, so crawlers/social scrapers get
// real content + meta tags, not an empty #root.
import '../styles/tokens.css';
// Re-skin experimentation layer: overrides token values on top of the baseline.
// Empty = baseline (Feedly green). Swap in a candidate to preview a palette.
import '../styles/active-theme.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Feedly',
  description = 'Track the topics and trends that matter to you.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/assets/mentaat-favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': 'https://mentaat.com/#organization',
          name: 'Mentaat',
          url: 'https://mentaat.com',
          email: 'hello@mentaat.com',
          description: 'A forward-deployed engineering and AI studio for boutique businesses',
          areaServed: 'New Jersey',
          address: {
            '@type': 'PostalAddress',
            addressRegion: 'New Jersey',
            addressCountry: 'US',
          },
          makesOffer: [
            {
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Service',
                name: 'Web development and digital products',
              },
            },
            {
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Service',
                name: 'AI workflow automation',
              },
            },
            {
              '@type': 'Offer',
              itemOffered: {
                '@type': 'Service',
                name: 'Custom software and operations engineering',
              },
            },
          ],
        },
        {
          '@type': 'WebSite',
          '@id': 'https://mentaat.com/#website',
          url: 'https://mentaat.com',
          name: 'Mentaat',
          description: 'A forward-deployed engineering and AI studio for boutique businesses',
          publisher: { '@id': 'https://mentaat.com/#organization' },
        },
      ],
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>
